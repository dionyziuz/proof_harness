# ==============================================================================
# Prime Math Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file (or .env.example.qwen / .env.example.muse) to .env and fill in
# your actual credentials.
# Note: .env is ignored by Git to prevent leaking personal keys or chat IDs.
# ==============================================================================

# --- Telegram Bot & User Notifications (Optional) ---
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_EXAMPLE"
TELEGRAM_CHAT_ID="1234567890"

# --- LLM Thinking & Orchestrator Endpoints ---
# Primary reasoning/thinking model (e.g. Qwen 3.8 27B via vLLM, or Meta Model API)
# Can use either PRIME_MATH_* or TUNNEL_* variable names:
PRIME_MATH_BASE_URL="http://127.0.0.1:8000/v1"
PRIME_MATH_API_KEY="sk-example-dummy-key-not-real"
PRIME_MATH_MODEL="default"
PRIME_MATH_TIMEOUT=600.0
PRIME_MATH_MAX_TOKENS=65536
# vLLM-specific request params (repetition_penalty, chat_template_kwargs, thinking budgets).
# Set false for strict OpenAI-compatible endpoints (e.g. Meta Model API) that reject them with 400.
# PRIME_MATH_VLLM_PARAMS=true
# Meta-native reasoning effort: minimal/low/medium/high/xhigh/max (see .env.example.muse).
# PRIME_MATH_REASONING_EFFORT=xhigh
# Effort level used when enable_thinking=False on reasoning_effort endpoints (default: minimal).
# PRIME_MATH_REASONING_EFFORT_DISABLED=minimal

# --- Fast Composer Model (Optional) ---
PRIME_MATH_FAST_ENABLED=false
PRIME_MATH_FAST_BASE_URL="http://127.0.0.1:8001/v1"
PRIME_MATH_FAST_API_KEY="sk-fast-example-key"
PRIME_MATH_FAST_MODEL="google/gemma-2-27b-it"

# --- Literature & Web Search (Optional) ---
JINA_API_KEY="jina_example_key_here"

# --- Context Compactor & Memory Ceilings ---
# Trigger threshold = MAX_CONTEXT_TOKENS - RESERVE_TOKENS = 48000 - 16000 = 32,000 tokens
TCS_COMPACTOR_MAX_CONTEXT_TOKENS=48000
TCS_COMPACTOR_RESERVE_TOKENS=16000
TCS_COMPACTOR_KEEP_RECENT_TURNS=2

# --- Main Solver Loop Settings ---
TCS_SOLVER_MAX_ITERATIONS=8
TCS_SOLVER_ENABLE_THINKING=true
TCS_SOLVER_THINKING_BUDGET=24576
TCS_SOLVER_TEMPERATURE=0.2
TCS_SOLVER_TIMEOUT_SECONDS=3600.0

# --- APU Kernel & Combinatorial Ceilings ---
TCS_KERNEL_TIMEOUT_SECONDS=12.0
TCS_COMBINATORIAL_CEILING_N=7

# --- Subagent Token Budgets & Timeouts ---
# Context Architect
TCS_ARCHITECT_MAX_TOKENS=8192
TCS_ARCHITECT_THINKING_BUDGET=2048
TCS_ARCHITECT_TIMEOUT_SECONDS=180.0

# Computational Falsifier
TCS_FALSIFIER_MAX_TOKENS=4096
TCS_FALSIFIER_THINKING_BUDGET=1536
TCS_FALSIFIER_TIMEOUT_SECONDS=120.0

# Adversarial Skeptic
TCS_SKEPTIC_MAX_TOKENS=2048
TCS_SKEPTIC_THINKING_BUDGET=1024
TCS_SKEPTIC_TIMEOUT_SECONDS=90.0

# Publication Scribe
TCS_SCRIBE_MAX_TOKENS=65536
TCS_SCRIBE_THINKING_BUDGET=16384
TCS_SCRIBE_TIMEOUT_SECONDS=360.0

# --- High-Potential Overtime Gate ---
TCS_ENABLE_OVERTIME=true
TCS_OVERTIME_ITERATIONS=4
TCS_OVERTIME_VALIDITY_THRESHOLD=0.35

# Proof Auditor (Referee)
TCS_AUDITOR_MAX_TOKENS=16384
TCS_AUDITOR_THINKING_BUDGET=12288
TCS_AUDITOR_TIMEOUT_SECONDS=360.0
TCS_AUDITOR_VALIDITY_THRESHOLD=0.70

# Official TCS Judge
TCS_JUDGE_MAX_TOKENS=16384
TCS_JUDGE_THINKING_BUDGET=12288
TCS_JUDGE_TIMEOUT_SECONDS=360.0

# --- TurboVec Semantic Memory ---
TCS_TURBOVEC_MIN_SCORE=0.68
TCS_TURBOVEC_LIMIT=5

# --- Continuous Pipeline & Worker Defaults ---
TCS_PIPELINE_WORKERS=2
TCS_PIPELINE_JUDGE_CONFIG=b
TCS_PIPELINE_JUDGE_THRESHOLD=0.50
TCS_PIPELINE_NICENESS=15
TCS_PIPELINE_JUDGE_THINKING=true
TCS_PIPELINE_JUDGE_ADAPTIVE=true

# --- Prime Math Research Web Portal ---
ADMIN_EMAILS="admin@example.org"
WEB_PORTAL_PORT=8790
WEB_PORTAL_HOST="0.0.0.0"
ADMIN_INVITATION_CODE="PRIME_MATH_ADMIN_2026"
PRIME_MATH_INVITE_CODE="PRIME_MATH_MATHEMATICIAN_2026"
SESSION_SECRET="prime-math-secret-session-key-2026"
