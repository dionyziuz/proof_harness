# ==============================================================================
# Prime Math Environment Configuration Template — Meta Muse Spark 1.3 (.env.example.muse)
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example.muse .env
# Note: .env is ignored by Git to prevent leaking personal keys or chat IDs.
#
# Why Muse Spark 1.3 needs larger *_MAX_TOKENS:
#   Meta's Model API (https://api.meta.ai/v1) rejects vLLM's `thinking_budget_tokens`
#   and counts internal `reasoning_tokens` directly inside `max_tokens`. At
#   `PRIME_MATH_REASONING_EFFORT=xhigh`, Muse Spark 1.3 routinely spends 10,000 to
#   20,000 reasoning tokens on complex proofs/audits before emitting visible text.
#   The budgets below give every subagent and judge generous room for both xhigh
#   reasoning AND the visible completion so responses never truncate to `content: null`.
# ==============================================================================

# --- Telegram Bot & User Notifications (Optional) ---
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_EXAMPLE"
TELEGRAM_CHAT_ID="1234567890"

# --- LLM Thinking & Orchestrator Endpoints (Meta Muse Spark 1.3) ---
PRIME_MATH_BASE_URL="https://api.meta.ai/v1"
PRIME_MATH_API_KEY="LLM_1234567890_example_meta_key"
PRIME_MATH_MODEL="muse-spark-1.3-contributor"
PRIME_MATH_TIMEOUT=600.0
PRIME_MATH_MAX_TOKENS=65536
# Strict OpenAI-compatible mode (disables vLLM-only parameters that return HTTP 400 on api.meta.ai)
PRIME_MATH_VLLM_PARAMS=false
# Meta-native reasoning effort for thinking calls: minimal | low | medium | high | xhigh | max
PRIME_MATH_REASONING_EFFORT=xhigh
# Effort level automatically used when enable_thinking=False (repair retries, query gen, heuristics).
# Meta API rejects 'none' with HTTP 400; 'minimal' uses ~14 reasoning tokens.
PRIME_MATH_REASONING_EFFORT_DISABLED=minimal

# --- Fast Composer Model (Optional) ---
PRIME_MATH_FAST_ENABLED=false
PRIME_MATH_FAST_BASE_URL="http://127.0.0.1:8001/v1"
PRIME_MATH_FAST_API_KEY="sk-fast-example-key"
PRIME_MATH_FAST_MODEL="google/gemma-2-27b-it"

# --- Literature & Web Search (Optional) ---
JINA_API_KEY="jina_example_key_here"

# --- Context Compactor & Memory Ceilings ---
TCS_COMPACTOR_MAX_CONTEXT_TOKENS=64000
TCS_COMPACTOR_RESERVE_TOKENS=16000
TCS_COMPACTOR_KEEP_RECENT_TURNS=2

# --- Main Solver Loop Settings ---
TCS_SOLVER_MAX_ITERATIONS=8
TCS_SOLVER_ENABLE_THINKING=true
TCS_SOLVER_THINKING_BUDGET=32768
TCS_SOLVER_TEMPERATURE=0.2
TCS_SOLVER_TIMEOUT_SECONDS=4800.0

# --- APU Kernel & Combinatorial Ceilings ---
TCS_KERNEL_TIMEOUT_SECONDS=12.0
TCS_COMBINATORIAL_CEILING_N=7

# --- Subagent Token Budgets & Timeouts (Muse Spark 1.3 Tiered Effort) ---
# Note: On Muse (`PRIME_MATH_VLLM_PARAMS=false`), `*_THINKING_BUDGET` is used
# locally in Python to select the Meta `reasoning_effort` tier:
#   <= 2048 -> "low" (fast 15-25s helper scripts for Architect, Falsifier, Skeptic)
#   <= 6144 -> "medium"
#   >  6144 -> PRIME_MATH_REASONING_EFFORT ("xhigh" for Prover, Scribe, Auditor, Judge)

# Context Architect (runs at "low" effort via budget=2048; fast 20s blueprint)
TCS_ARCHITECT_MAX_TOKENS=16384
TCS_ARCHITECT_THINKING_BUDGET=2048
TCS_ARCHITECT_TIMEOUT_SECONDS=180.0

# Computational Falsifier (runs at "low" effort via budget=1536; fast 15s test script)
TCS_FALSIFIER_MAX_TOKENS=12288
TCS_FALSIFIER_THINKING_BUDGET=1536
TCS_FALSIFIER_TIMEOUT_SECONDS=150.0

# Adversarial Skeptic & Critique Falsifier (runs at "low" effort via budget=1024; fast 15s attack script)
TCS_SKEPTIC_MAX_TOKENS=12288
TCS_SKEPTIC_THINKING_BUDGET=1024
TCS_SKEPTIC_TIMEOUT_SECONDS=150.0

# Publication Scribe (runs at full "xhigh" effort via budget=24576)
TCS_SCRIBE_MAX_TOKENS=65536
TCS_SCRIBE_THINKING_BUDGET=24576
TCS_SCRIBE_TIMEOUT_SECONDS=480.0

# --- High-Potential Overtime Gate ---
TCS_ENABLE_OVERTIME=true
TCS_OVERTIME_ITERATIONS=4
TCS_OVERTIME_VALIDITY_THRESHOLD=0.35
TCS_OVERTIME_SECONDS_PER_ITER=600.0

# Proof Auditor (Internal Referee: xhigh reasoning uses 8k-19k tokens + 1k JSON output)
TCS_AUDITOR_MAX_TOKENS=32768
TCS_AUDITOR_THINKING_BUDGET=24576
TCS_AUDITOR_TIMEOUT_SECONDS=420.0
TCS_AUDITOR_VALIDITY_THRESHOLD=0.70

# Official TCS Judge (Stage 2 Evaluation: xhigh reasoning uses 8k-20k tokens + 1k JSON output)
TCS_JUDGE_MAX_TOKENS=32768
TCS_JUDGE_THINKING_BUDGET=24576
TCS_JUDGE_TIMEOUT_SECONDS=420.0

# --- TurboVec Semantic Memory ---
TCS_TURBOVEC_MIN_SCORE=0.68
TCS_TURBOVEC_LIMIT=5

# --- Continuous Pipeline & Worker Defaults ---
TCS_PIPELINE_WORKERS=2
TCS_PIPELINE_JUDGE_CONFIG=b
TCS_PIPELINE_JUDGE_THRESHOLD=0.50
TCS_PIPELINE_NICENESS=15
TCS_PIPELINE_JUDGE_THINKING=true
TCS_PIPELINE_JUDGE_ADAPTIVE=true

# --- Prime Math Research Web Portal ---
ADMIN_EMAILS="admin@example.org"
WEB_PORTAL_PORT=8790
WEB_PORTAL_HOST="0.0.0.0"
ADMIN_INVITATION_CODE="PRIME_MATH_ADMIN_2026"
PRIME_MATH_INVITE_CODE="PRIME_MATH_MATHEMATICIAN_2026"
SESSION_SECRET="prime-math-secret-session-key-2026"
